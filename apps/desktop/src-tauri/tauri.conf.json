{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Organify",
  "version": "0.16.1",
  "identifier": "app.organify.personal",
  "build": {
    "beforeDevCommand": "corepack pnpm --filter @organify/web dev --host 127.0.0.1 --port 5173 --strictPort",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "corepack pnpm --filter @organify/web build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Organify",
        "width": 1200,
        "height": 800,
        "visible": false,
        "decorations": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI --disable-background-timer-throttling"
      }
    ]
  },
  "bundle": {
    "active": true,
    "publisher": "Capnology Studios",
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "installerHooks": "installer-hooks.nsh"
      }
    },
    "icon": ["icons/icon.ico"]
  }
}
